{
  "name": "prompt-forge-desktop",
  "version": "1.0.0",
  "description": "Always-on-top floating widget for Prompt Forge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shubham.promptforge",
    "productName": "Prompt Forge",
    "files": ["main.js", "preload.js", "bubble.html", "assets/**/*"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
